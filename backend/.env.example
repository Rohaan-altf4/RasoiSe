# Copy this file to .env and fill in the values.

PORT=3000

# Admin account created on first start (password: 8+ characters)
ADMIN_EMAIL=admin@rasoise.in
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=RasoiSe Admin

# Google Maps (Maps JavaScript + Places APIs). Leave empty to use OpenStreetMap instead.
GOOGLE_MAPS_API_KEY=

# Share of each delivered meal kept by the platform (0.1 = 10%)
PLATFORM_COMMISSION=0.1

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Password given to chef accounts created by the one-time legacy migration
MIGRATION_DEFAULT_PASSWORD=rasoise123

# Optional: pretend "now" is this moment (ISO time) to demo the 8 AM cutoff. Time keeps ticking from it.
# RASOI_NOW=2026-10-16T07:30:00+05:30

# ---- When deploying (Render, Railway, a VPS...) ----
# Folder on a persistent disk for data.json and chef photos. Without it they are lost on redeploy.
# DATA_DIR=/var/data
# Set true behind the host's HTTPS proxy (with COOKIE_SECURE=true)
# TRUST_PROXY=true
# Max sign-in / sign-up attempts per IP every 15 minutes
# AUTH_RATE_LIMIT=10
